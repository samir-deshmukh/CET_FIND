# Copy this file to .env.docker-local and replace the placeholder values.
POSTGRES_USER=cetfind
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=cetfind
DATABASE_URL=postgresql+psycopg2://cetfind:replace-with-a-local-password@db:5432/cetfind
CET_ADMIN_SESSION_SECRET=replace-with-a-long-random-local-secret

# Optional: enables Gemini-powered Website Resolver in the local backend.
# Put your newly generated key in .env.docker-local, never commit that file.
GEMINI_API_KEY=replace-with-your-new-gemini-api-key
GEMINI_RESOLVER_MODEL=gemini-2.5-flash
